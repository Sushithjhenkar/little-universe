{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "some-bonds-stay-golden-private-preview",
  "main": "src/private-worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "73921",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
